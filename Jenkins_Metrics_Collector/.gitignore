# ============================================
# Jenkins Metrics Collector - .gitignore
# ============================================

# --------------------------------------------
# Archivos de Entorno y Configuración Sensible
# --------------------------------------------
.env
.env.local
.env.*.local
*.env
secrets.yaml
*-secret.yaml.local

# --------------------------------------------
# Python
# --------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
ENV/
env/
.venv/

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# --------------------------------------------
# Docker
# --------------------------------------------
# Datos persistentes de Docker Compose
Jenkis-Docker/postgres_data/
Jenkis-Docker/grafana_data/

# Volúmenes montados
**/postgres_data/
**/grafana_data/
**/data/

# Docker compose override local
docker-compose.override.yml
docker-compose.local.yml

# --------------------------------------------
# PostgreSQL
# --------------------------------------------
*.sql.backup
*.dump
pg_data/
pgdata/

# --------------------------------------------
# Grafana
# --------------------------------------------
grafana.db
grafana.db-journal
plugins/
alerting/

# --------------------------------------------
# Kubernetes
# --------------------------------------------
# Archivos de secretos locales (nunca commitear secretos reales)
Jenkis-K8S/secrets/*.local.yaml
Jenkis-K8S/secrets/real-*.yaml

# Kubeconfig local
kubeconfig
.kube/

# Helm
*.tgz
charts/

# Kustomize builds
kustomize-build/

# --------------------------------------------
# IDEs y Editores
# --------------------------------------------
# VSCode
.vscode/
*.code-workspace

# JetBrains (PyCharm, IntelliJ)
.idea/
*.iml
*.ipr
*.iws

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~
.netrwhist

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# Cursor IDE
.cursorignore
.cursor/

# --------------------------------------------
# Sistema Operativo
# --------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# --------------------------------------------
# Logs y Temporales
# --------------------------------------------
*.log
*.tmp
*.temp
*.bak
*.backup
logs/
log/
tmp/
temp/

# --------------------------------------------
# Archivos de Build y Compilación
# --------------------------------------------
*.o
*.obj
*.exe
*.dll
*.dylib
*.so
*.a

# --------------------------------------------
# Archivos comprimidos
# --------------------------------------------
*.zip
*.tar.gz
*.tgz
*.rar
*.7z

# --------------------------------------------
# Otros
# --------------------------------------------
# Node modules (si se usan herramientas JS)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Terraform (si se usa para infraestructura)
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl

# Archivos de notas personales
NOTES.md
TODO.md
PERSONAL.md
scratch/

