# General Configuration
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=metrics_main
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin123

# Jenkins Collector Configuration
JENKINS_URL=http://your-jenkins-url:8080
JENKINS_USER=admin
JENKINS_TOKEN=your-jenkins-token-here
JENKINS_POLL_INTERVAL=60

# SonarQube Collector Configuration
SONARQUBE_URL=http://your-sonarqube-url:9000
SONARQUBE_TOKEN=your-sonarqube-token-here
SONARQUBE_POLL_INTERVAL=3600
DATA_RETENTION_DAYS=365

# Jira Collector Configuration
JIRA_URL=https://your-domain.atlassian.net
JIRA_USER=your-email@example.com
JIRA_TOKEN=your-api-token-here
JIRA_PROJECTS=PROJ1,PROJ2
JIRA_POLL_INTERVAL=3600
