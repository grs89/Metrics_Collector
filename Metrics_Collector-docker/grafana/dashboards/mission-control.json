{
    "annotations": {
        "list": [
            {
                "builtIn": 1,
                "datasource": {
                    "type": "datasource",
                    "uid": "grafana"
                },
                "enable": true,
                "hide": true,
                "iconColor": "rgba(0, 211, 255, 1)",
                "name": "Annotations & Alerts",
                "type": "dashboard"
            }
        ]
    },
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 0,
    "id": null,
    "links": [],
    "liveNow": false,
    "panels": [
        {
            "datasource": {
                "type": "postgres",
                "uid": "Mission Control"
            },
            "description": "Estado en tiempo real de los recolectores de métricas",
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "custom": {
                        "align": "auto",
                        "cellOptions": {
                            "type": "auto"
                        },
                        "inspect": false
                    },
                    "mappings": [
                        {
                            "options": {
                                "ERROR": {
                                    "color": "red",
                                    "index": 1,
                                    "text": "CRITICAL"
                                },
                                "OK": {
                                    "color": "green",
                                    "index": 0,
                                    "text": "HEALTHY"
                                },
                                "UNKNOWN": {
                                    "color": "gray",
                                    "index": 2,
                                    "text": "WAITING"
                                },
                                "WARNING": {
                                    "color": "orange",
                                    "index": 3,
                                    "text": "ISSUES"
                                }
                            },
                            "type": "value"
                        }
                    ],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            }
                        ]
                    }
                },
                "overrides": [
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "status"
                        },
                        "properties": [
                            {
                                "id": "custom.cellOptions",
                                "value": {
                                    "mode": "basic",
                                    "type": "color-background"
                                }
                            }
                        ]
                    }
                ]
            },
            "gridPos": {
                "h": 10,
                "w": 24,
                "x": 0,
                "y": 0
            },
            "id": 1,
            "options": {
                "footer": {
                    "fields": "",
                    "reducer": [
                        "sum"
                    ],
                    "show": false
                },
                "showHeader": true
            },
            "pluginVersion": "10.2.2",
            "targets": [
                {
                    "datasource": {
                        "type": "postgres",
                        "uid": "Mission Control"
                    },
                    "format": "table",
                    "rawQuery": true,
                    "refId": "A",
                    "sql": "SELECT collector_name as collector, status, last_run, details FROM collector_status ORDER BY collector_name ASC"
                }
            ],
            "title": "Collectors Health Status (Real-Time)",
            "type": "table"
        }
    ],
    "refresh": "10s",
    "schemaVersion": 38,
    "style": "dark",
    "tags": [
        "health",
        "management"
    ],
    "templating": {
        "list": []
    },
    "time": {
        "from": "now-6h",
        "to": "now"
    },
